# Admin login (/admin). Required.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Optional: random string used to sign admin sessions. If empty, one is derived from the
# username/password. Changing it (or the password) signs out every admin session.
ADMIN_SESSION_SECRET=

# Supabase database + image storage (Project Settings > API). Required for admin changes
# to be saved and shown on the live store; without these the admin runs in browser-only demo mode.
NEXT_PUBLIC_SUPABASE_URL=
# Server-only key. NEVER expose this in browser code or commit .env.local.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: bearer token for scripted API access (Authorization: Bearer <key>).
ADMIN_API_KEY=

# Public site address (e.g. https://alkharoof.com), used for canonical URLs, the sitemap and
# link previews. Optional on Vercel: falls back to the project's production URL.
NEXT_PUBLIC_SITE_URL=

# Optional: protects /api/keepalive (Vercel sends it automatically to cron jobs when set)
CRON_SECRET=
